{
  "name": "shadowstream",
  "version": "27.0.0-beta.2.0",
  "private": true,
  "description": "ShadowStream - replay buffer e multi-streaming (Electron + OBS Studio + .NET 8)",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "start:debug": "electron . --devtools",
    "test": "node --test",
    "backend:build": "dotnet build",
    "backend:run": "dotnet run --project . -- --headless --no-autostart --meter-only",
    "backend:publish": "dotnet publish ShadowStream.csproj -c Release -r win-x64 --self-contained true -o publish/backend",
    "build:win": "npm run backend:publish && electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "it.shadowstream.app",
    "productName": "ShadowStream",
    "asar": true,
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "publish/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "electron/assets/icon.ico",
      "artifactName": "ShadowStream-${version}-Setup-64bit.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "thesqualoman1974",
        "repo": "ShadowStream-versione-27-beta-1"
      }
    ]
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  }
}
